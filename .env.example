# Copy to .env in your shell only; never commit a real key.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Embedding (same OpenAI-compatible contract as Project 1):
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# For a Google AI Studio key:
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_MODEL=gemini-embedding-001  (do not use text-embedding-004: HTTP 404 on v1beta)
# RETRIEVER=embedding  # force embedding (error with no key); RETRIEVER=tfidf forces TF-IDF
